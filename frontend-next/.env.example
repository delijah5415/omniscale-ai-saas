# Public browser-safe Supabase values. Never put service-role or PayPal secrets here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Existing Express API base URL including /api. Required for a separate Vercel preview origin.
NEXT_PUBLIC_API_URL=
